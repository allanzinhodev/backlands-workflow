# Repositórios das ferramentas (clonados separadamente, cada um tem seu próprio git)
# Origem:
#   devfolio      -> https://github.com/allanzinhodev/devfolio
#   mapeditor     -> https://github.com/allanzinhodev/backlands-mapeditor
#   objectbuilder -> https://github.com/allanzinhodev/backlands-objectbuilder
/devfolio/
/mapeditor/
/objectbuilder/

# client/ e server/ agora fazem parte deste repositório (clones de conteúdo
# do upstream Mateuzkl, sem histórico git próprio). Cache de build (vcpkg,
# binários) já é coberto pelos .gitignore internos de cada pasta.

# Dependências
node_modules/

# vcpkg, quando o bootstrap o instala dentro do workspace
/vcpkg/

# Build / saída
dist/
build/
out/
bin/
obj/

# Ambiente e credenciais
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operacional
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editores / IDEs
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Temporários
*.tmp
*.bak

# Saida das varreduras de UI (uisweep/uideep). Sao capturas de trabalho: mudam a
# cada rodada e o que importa delas ja esta no commit que a rodada gerou.
/shots/
